{
  "name": "banana-logger",
  "version": "1.0.0",
  "description": "Banana Logger 🍌 — A hybrid client/server TypeScript logger with formatting, callbacks, timing, child loggers, and banana emojis.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build:bun": "bun build ./src/index.ts --outdir=dist --format esm --sourcemap=linked --minify --external pino --external pino-pretty",
    "build:ts": "tsc --project tsconfig.json --pretty",
    "build": "bun run clean && bun run build:bun && bun run build:ts",
    "clean": "rm -rf dist",
    "examples": "bun ./examples.ts",
    "lint": "eslint ./src",
    "prepublishOnly": "bun run build",
    "test": "bun test --coverage",
    "test:ci": "bun run lint && bun test"
  },
  "keywords": [
    "logger",
    "typescript",
    "pino",
    "logging",
    "banana",
    "emoji",
    "hybrid",
    "browser",
    "server",
    "isomorphic"
  ],
  "author": "Marco Trevisani <marco.trevisani81@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/bun": "^1.1.6",
    "@types/node": "^20.14.10",
    "eslint": "^9.6.0",
    "globals": "^15.8.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^7.15.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.1.18",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trevonerd/banana.git"
  },
  "bugs": {
    "url": "https://github.com/trevonerd/banana/issues"
  },
  "homepage": "https://github.com/trevonerd/banana#readme"
}
